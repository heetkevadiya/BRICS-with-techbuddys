# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brics
CORS_ORIGINS=http://localhost:5173

# Google AI (mandatory for the hackathon)
GEMINI_API_KEY=            # from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_APPLICATION_CREDENTIALS=   # service-account JSON path for Speech/Translation/BigQuery
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=citizen_demand
BIGQUERY_LOCATION=asia-south1

# data.gov.in — Open Government Data Platform India.
# Optional: a free personal key from https://data.gov.in/apis avoids the shared sample key's rate limits.
DATAGOV_API_KEY=

# Firebase Auth (roles via custom claims)
FIREBASE_PROJECT_ID=

# Country / state configuration
DEFAULT_COUNTRY=IN
DEFAULT_STATE=Gujarat
